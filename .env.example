# Copy this file to ".env" and fill in your own values.
# NEVER commit your real .env file (it is already in .gitignore).

# Which LLM provider to use from Week 2 onwards: gemini | groq | ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=

# Embedding model (runs locally on CPU, ~90 MB download on first use)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking and retrieval settings (you will tune these in Week 1)
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
